includes:
	- tests/phpstan/configs/expected-test-errors.neon
	- tests/phpstan/configs/impossible-mixed.neon
	- tests/phpstan/configs/phpstan-bugs.neon

parameters:
	level: 10
	treatPhpDocTypesAsCertain: false
	paths:
		- src
		- tests
	excludePaths:
		- tests/phpstan/stubs
	scanFiles:
		- tests/phpstan/stubs/encoding.php
